# Local dev default — a SQLite file, $0, no external service required.
# connection_limit=1 forces Prisma through a single connection to the
# file, which avoids intermittent SQLITE_BUSY lock contention between
# concurrent requests (SQLite itself is single-writer; Prisma's default
# pool otherwise opens multiple connections that can contend for the
# same file lock). Switching to Postgres in production removes the need
# for this — see docs/COST_STRATEGY.md.
DATABASE_URL="file:./dev.db?connection_limit=1"

# Optional. Leave unset to use the free, local, rule-based AI assistant.
# Set this to enable real Claude-powered responses (pay-per-token, "cheap" tier).
# ANTHROPIC_API_KEY=

# Optional, defaults to claude-sonnet-5 when ANTHROPIC_API_KEY is set.
# ANTHROPIC_MODEL=
